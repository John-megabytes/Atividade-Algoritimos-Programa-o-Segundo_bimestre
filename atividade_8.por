programa
{
	
	funcao inicio()
	{
  cadeia mae = "Tess"
  cadeia filha = "Anna"
  cadeia caixa

  caixa = mae
  mae = filha
  filha = caixa 
  escreva( mae, " ", filha)
	}
}
