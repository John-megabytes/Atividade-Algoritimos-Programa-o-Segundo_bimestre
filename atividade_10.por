programa
{
	
	funcao inicio()
	{
		inteiro ADG
        inteiro largura = 68
        inteiro comprimento = 105
        inteiro ADGdb 
        inteiro ADGcm

        ADG = largura * comprimento
        escreva(ADG)
        ADGdb = ADG * 2
        escreva("\n", ADGdb)
        ADGcm = ADGdb * 100
        escreva("\n", ADGcm)
	}
}
