programa
{
	
	funcao inicio()
	{
	inteiro metros
      inteiro centimetros

      escreva("quantos metros para a conversao")
      leia(metros)
      centimetros = metros *100

      escreva("entao serao ", centimetros," centimetros")
	}
}
